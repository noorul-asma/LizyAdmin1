##############################################################################
# Lizy Admin — environment configuration
#
# Copy this file to .env, then fill in the placeholder values below for
# YOUR server. Never commit the real .env file (it already is git-ignored).
# Generate a real APP_KEY with: php artisan key:generate
##############################################################################

APP_NAME="Lizy Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The real, public https:// domain this backend is deployed on.
# NEVER localhost/127.0.0.1 in production — every generated file/image
# URL (Media::getUrlAttribute) is built from this value, so if it's
# wrong every image link on LizyNet/LizyGo/LizyRealty breaks for anyone
# who isn't on this exact machine.
APP_URL=https://admin.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

##############################################################################
# DATABASE — MySQL (production)
##############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lizy_admin
DB_USERNAME=lizy_admin_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set this to your real domain in production (e.g. admin.example.com) so
# the session cookie is scoped correctly. Leave blank for local dev only.
SESSION_DOMAIN=
# true in production once served over https (it always should be)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

##############################################################################
# CORS / Sanctum — which frontend domains are allowed to call this API.
# The public API (api/public/*) already allows any origin (see
# config/cors.php) since it's read-only public data, so this mainly
# matters for the admin panel's own session-based requests if you ever
# serve the admin frontend from a separate domain than APP_URL.
##############################################################################
SANCTUM_STATEFUL_DOMAINS=admin.example.com

VITE_APP_NAME="${APP_NAME}"
